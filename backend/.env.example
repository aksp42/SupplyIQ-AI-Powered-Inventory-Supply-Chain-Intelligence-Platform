# SupplyIQ Backend — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Create the schema first:  mysql -u root -p supplyiq < backend/supplyiq_schema.sql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=supplyiq

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this signs everyone out.
JWT_SECRET=replace_with_a_long_random_string

# Token lifetime. Format: 30m, 24h, 7d
JWT_EXPIRES_IN=7d

# bcrypt cost factor. Higher = slower + safer. 10 is a good default.
BCRYPT_ROUNDS=10

# ── Firebase (Google / Microsoft sign-in) ─────────────────────────────────────
# The public web API key from frontend/firebase-config.js. Not a secret, but it
# is required so the backend can verify Firebase ID tokens.
FIREBASE_API_KEY=your_firebase_web_api_key

# ── Email OTP (signup verification + password reset) ──────────────────────────
# SupplyIQ mails its own codes; Firebase is not used for either flow.
#
# SMTP_HOST/SMTP_USER/SMTP_PASS are real credentials — never commit a filled-in
# .env. For Gmail use an App Password (Google Account → Security → 2-Step
# Verification → App passwords), not your account password, and enable 2FA first
# or Google will reject the login.
#
# Mail from a bare personal Gmail account is often classified as bulk and lands
# in spam. Sending from a domain you own (SPF/DKIM configured) is far more
# reliable. Until SMTP is configured the server logs the code to its console and,
# in non-production only, returns it as `devCode` so the flow stays testable.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=SupplyIQ <your_email@gmail.com>

# Server-side pepper mixed into every OTP digest. Without it OTP codes cannot be
# hashed safely. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OTP_PEPPER=replace_with_a_long_random_string

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# ── Demo seed account ────────────────────────────────────────────────────────
# The owner account `npm run db:seed` creates. The integration suites sign in as
# this user, so the seeder and the suites must agree: set DEMO_PASSWORD here and
# both read the same value. Leave it blank to accept the built-in dev default.
DEMO_EMAIL=demo@supplyiq.local
DEMO_PASSWORD=replace_with_a_demo_password
DEMO_STORE_ID=demo-store-01

# ── Seeding behaviour ────────────────────────────────────────────────────────
# A brand-new workspace is created empty on purpose, so a genuine signup never
# sees someone else's sample catalogue. Set to 1 only while developing, if you
# want a new workspace to start with the grocery demo data.
SEED_NEW_WORKSPACES=

# ── Imports ──────────────────────────────────────────────────────────────────
# Largest CSV upload the server will accept, in bytes. Default 12582912 (12 MB).
MAX_IMPORT_BYTES=12582912

# ── Tests ────────────────────────────────────────────────────────────────────
# Port the integration suites expect a running backend on. Default 4000.
TEST_PORT=4000

# ── ML service (backend/ml) ──────────────────────────────────────────────────
# The forecasting service reads the same DB_* values as the backend. There is no
# second credential to configure: ml/config.py takes DB_PASSWORD from the
# environment with no default, so a missing value fails loudly instead of
# silently connecting with something guessable.
ML_PORT=8001
ML_HOST=0.0.0.0

# Forecast horizon and how much history a product needs before it is modelled.
FORECAST_HORIZON_DAYS=30
MIN_HISTORY_DAYS=14
SEASONAL_PERIOD=7
RETRAIN_FREQUENCY_DAYS=7

# Model registry location (relative to backend/ml).
MODEL_REGISTRY_PATH=./models/registry

# Baseline model hyperparameters.
LIGHTGBM_N_ESTIMATORS=200
LIGHTGBM_LEARNING_RATE=0.05
LIGHTGBM_MAX_DEPTH=6
LIGHTGBM_RANDOM_STATE=42

# Backtesting / evaluation windows.
MIN_TRAIN_DAYS=14
VALIDATION_DAYS=30
MIN_OBS_PER_PRODUCT=14

# Python service log level.
LOG_LEVEL=INFO
